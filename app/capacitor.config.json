{
  "appId": "com.nvpschool.app",
  "appName": "NVP School",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://nvpschool.vercel.app",
    "cleartext": true,
    "androidScheme": "https",
    "allowNavigation": [
      "nvpschool.vercel.app",
      "*.vercel.app",
      "*.onrender.com",
      "localhost"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#020617",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#020617"
    }
  }
}
