# ============================================================
#   NVP ENGLISH MEDIUM SCHOOL PORTAL — Environment Variables
# ============================================================

# Server
NODE_ENV=production
PORT=10000

# MongoDB Atlas Connection URI
# Replace with your actual Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/nvp_school?retryWrites=true&w=majority

# JWT Secret (change this to a long random string in production)
JWT_SECRET=nvp_school_super_secret_jwt_key_2026_change_this

# Master Recovery Key for Head Administrator Emergency Password Reset
ADMIN_RECOVERY_KEY=NVP-HEAD-RECOVERY-KEY-2026

# CORS Origin (optional if frontend is served by backend)
FRONTEND_URL=https://your-frontend-url.onrender.com
